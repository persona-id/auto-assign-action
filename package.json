{
  "name": "auto-assign-action",
  "version": "2.0.0",
  "description": "Add reviewers to pull requests when pull requests are opened.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/persona-id/auto-assign-action.git"
  },
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "prepare": "husky install"
  },
  "author": "Kentaro Matsushita",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^7.0.0",
    "js-yaml": "^3.15.0",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@octokit/webhooks-types": "7.6.1",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "3.12.1",
    "@types/lodash": "4.14.141",
    "@types/node": "20.19.43",
    "@vercel/ncc": "0.38.3",
    "husky": "8.0.3",
    "jest": "30.4.2",
    "jest-circus": "30.4.2",
    "jest-mock": "30.4.1",
    "lint-staged": "16.4.0",
    "prettier": "3.6.2",
    "ts-jest": "29.4.12",
    "typescript": "5.8.3"
  },
  "resolutions": {
    "@actions/http-client": "^3.0.2",
    "undici": "^6.28.0",
    "brace-expansion": "5.0.9",
    "glob@^10.2.2": "10.5.0",
    "js-yaml": "^3.15.0",
    "minimatch": "10.2.6",
    "tar": "^7.5.22",
    "test-exclude": "8.0.0"
  },
  "lint-staged": {
    "*.ts": "prettier --write"
  },
  "packageManager": "yarn@4.9.2"
}
